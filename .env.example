# LabReach — Environment Variables Template
# Copy this to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# Google AI API key — get from aistudio.google.com (free tier available)
# Used by the research agent, the evaluator, and both synthesis jobs (Gemini).
GOOGLE_AI_API_KEY=AIza...

# Anthropic API key — get from console.anthropic.com
# Required by the email writer (Claude). Without it, writeEmail() returns an
# unwritten passthrough draft, so the pipeline appears to "work" but produces
# no real email. Always set this.
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl API key — get from firecrawl.dev (free tier available)
FIRECRAWL_API_KEY=fc-...

# Vercel KV — auto-populated when you link a KV database in Vercel dashboard
# For local dev: create a KV store at vercel.com/storage and copy the .env.local values
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# Admin page password — choose anything, keep it secret
ADMIN_PASSWORD=your-admin-password-here

# Neon Postgres — the lab knowledge base + user data. Get both URLs from the Neon dashboard
# (or the Vercel integration). App code uses the pooled DATABASE_URL; scripts/migrate.mjs prefers
# DATABASE_URL_UNPOOLED for DDL.
DATABASE_URL=postgres://...
DATABASE_URL_UNPOOLED=postgres://...

# ── Google sign-in (optional accounts) ────────────────────────────────────────
# ALL THREE unset = auth is fully disabled: no sign-in button renders, the auth/data APIs 404/401,
# and the app runs guest-only exactly as before. Set all three to enable accounts.
#
# 1. AUTH_SECRET — signs the session JWT. Generate: `openssl rand -base64 32` (or `npx auth secret`).
# 2. Google OAuth app: console.cloud.google.com → APIs & Services → OAuth consent screen (External),
#    then Credentials → Create credentials → OAuth client ID → Web application. Authorized redirect
#    URIs: https://<your-domain>/api/auth/callback/google AND http://localhost:3000/api/auth/callback/google
# NOTE: an unverified Google app is capped at 100 total users until you submit the consent screen
# for verification (free, takes days). Fine for small workshops; verify before real club-scale use.
# AUTH_SECRET=...
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Failsafes (optional) ──────────────────────────────────────────────────────
# Kill switch: set to 1 to instantly halt ALL model calls on /api/digest (503) — no redeploy needed.
# Leave unset/0 in normal operation. Flip in the Vercel dashboard if a key leaks or costs spike.
# LLM_DISABLED=0
#
# Global daily ceiling on browse (the only paid path, ~$0.0015/call). Generous anti-runaway backstop,
# NOT a per-user limit — set high enough that real users never hit it. Defaults to 5000/day if unset.
# LLM_DAILY_CAP=5000
