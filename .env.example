# LabReach — Environment Variables Template
# Copy this to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# Google AI API key — get from aistudio.google.com (free tier available)
# The ONLY model key the app needs: research, digest, writer, evaluator, and both
# synthesis jobs all run on Gemini. One key runs the whole app.
GOOGLE_AI_API_KEY=AIza...

# Gemini model per stage — OPTIONAL. All default to gemini-2.5-flash, so a fresh
# clone runs entirely on the free tier. Override per stage for a paid deploy: the
# writer is the one worth spending on (a better first draft = less editing in the
# review queue); research and evaluation are extraction/classification and stay cheap.
#   GEMINI_WRITER_MODEL=gemini-3.5-flash
#   GEMINI_RESEARCH_MODEL=gemini-2.5-flash
#   GEMINI_EVAL_MODEL=gemini-2.5-flash

# Firecrawl API key — get from firecrawl.dev (free tier available)
FIRECRAWL_API_KEY=fc-...

# Storage (Redis over REST) — OPTIONAL for local dev. When unset, LabReach falls
# back to a local JSON file at .tmp/kv-store.json, which is correct for running the
# app off the repo. For a real deploy, provision an Upstash Redis database from the
# Vercel Marketplace (free tier); it populates these two vars, and lib/kv.ts uses
# them automatically. (The @vercel/kv client reads exactly these Upstash vars.)
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# Whole-app password — OPTIONAL. When set, every page/route requires this password
# (HTTP Basic Auth) via middleware.ts. Set it before a public deploy so only people
# you share it with can use the app (and spend your API credits). Leave unset for
# local dev — the gate is a no-op.
SITE_PASSWORD=

# Admin page password — choose anything, keep it secret. Gates /admin and /api/admin.
ADMIN_PASSWORD=your-admin-password-here
